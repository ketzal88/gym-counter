rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin: el email solo vale si está verificado (si no, alguien podría registrarlo con Email/Password).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'gabrielucc@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Campos de facturación: solo los escribe el servidor (Admin SDK, webhook de Stripe).
    function billingKeys() {
      return ['subscriptionStatus', 'subscriptionTier', 'subscriptionStartDate', 'subscriptionEndDate',
              'subscriptionCancelAtPeriodEnd', 'stripeCustomerId', 'stripeSubscriptionId',
              'trialStartDate', 'trialEndDate'];
    }

    // Única excepción: el onboarding arranca el trial de la app UNA vez, con fechas actuales y ≤ 14 días.
    function isValidTrialStart() {
      let d = request.resource.data;
      return d.subscriptionStatus == 'trial'
        && d.trialStartDate is timestamp && d.trialEndDate is timestamp
        && d.trialStartDate > request.time - duration.value(1, 'd')
        && d.trialStartDate < request.time + duration.value(1, 'd')
        && d.trialEndDate <= d.trialStartDate + duration.value(14, 'd');
    }

    // Users collection
    match /users/{userId} {
      // Lectura: propio usuario O admin
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.keys().hasAny(billingKeys())
        || (request.resource.data.keys().toSet().intersection(billingKeys().toSet())
              .hasOnly(['subscriptionStatus', 'trialStartDate', 'trialEndDate'])
            && isValidTrialStart())
      );

      allow update: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(billingKeys())
        || (request.resource.data.diff(resource.data).affectedKeys().intersection(billingKeys().toSet())
              .hasOnly(['subscriptionStatus', 'trialStartDate', 'trialEndDate'])
            && !('subscriptionStatus' in resource.data)
            && !('trialStartDate' in resource.data)
            && !('stripeSubscriptionId' in resource.data)
            && isValidTrialStart())
      );

      // Borrar y recrear el doc reiniciaría el trial: solo admin.
      allow delete: if isAdmin();

      // Admin: escritura completa
      allow create, update: if isAdmin();
    }

    // Rate limit de las rutas API (server-only: Admin SDK)
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // Plan variants (read-only for authenticated users)
    match /planVariants/{variantId} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins via backend
    }

    // Subscription events (read-only for owner)
    match /subscriptionEvents/{eventId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only webhooks can write
    }

    // Stripe idempotency ledger (server-only: written by the webhook via Admin SDK)
    match /processedStripeEvents/{stripeEventId} {
      allow read, write: if false; // Admin SDK bypasses rules; clients have no access
    }

    // User badges (read for owner, write via backend)
    match /userBadges/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only backend can update badges
    }

    // Visits collection
    match /visits/{visitId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Workouts collection
    match /workouts/{workoutId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Measurements collection
    match /measurements/{measurementId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Max weights collection
    match /maxWeights/{weightId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User training state
    match /userTrainingState/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
